# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Not read by any code yet;
# reserved for future admin operations (e.g. resume storage signed URLs).
SUPABASE_SERVICE_ROLE_KEY=

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional — defaults to a current free-tier-eligible Gemini model if unset.
# See lib/ai/providers/gemini.ts for why this needs occasional review;
# Gemini model lifecycles are short (months, not years).
GEMINI_MODEL=